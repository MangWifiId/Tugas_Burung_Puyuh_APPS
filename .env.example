# ==========================================
# Konfigurasi Backend (Go + Gin + PostgreSQL)
# ==========================================
PORT=8080
GIN_MODE=debug # debug, release
APP_ENV=development

# Lokasi penyimpanan database JSON (data utama aplikasi)
DATA_DIR=data

# Izinkan registrasi publik meski akun sudah ada (default: false)
ALLOW_REGISTRATION=false

# Database PostgreSQL Online / Lokal
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=quail_management
DB_SSLMODE=disable # disable, require, verify-full
# Opsional jika menggunakan connection string penuh:
# DATABASE_URL=postgres://user:password@localhost:5432/quail_management?sslmode=disable

# JWT Secret untuk Autentikasi
JWT_SECRET=super_secret_jwt_key_please_change_in_production
JWT_EXPIRES_HOURS=72

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# Konfigurasi Frontend (React + Vite)
# ==========================================
VITE_API_BASE_URL=/api/v1

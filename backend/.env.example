APP_ENV=development
PORT=8080
APP_TIMEZONE=Asia/Jakarta

# Pilihan: postgres | sqlite
# Kosongkan DB_DRIVER dan DATABASE_URL untuk memakai SQLite lokal (development).
DB_DRIVER=postgres
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/manajemen_puyuh?sslmode=require
SQLITE_PATH=data/puyuh.db

JWT_SECRET=ganti-dengan-kunci-acak-yang-panjang
JWT_EXPIRY_HOURS=24

ADMIN_NAME=Pemilik Kandang
ADMIN_EMAIL=admin@kandang.local
ADMIN_PASSWORD=Admin123!
SEED_DEMO=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

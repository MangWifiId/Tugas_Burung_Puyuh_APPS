# Contoh konfigurasi Nginx untuk deploy satu domain.
#
# Skema:
#   https://domain-anda.com/        -> file statis frontend (frontend/dist)
#   https://domain-anda.com/api/... -> backend Go di 127.0.0.1:8080
#
# Ganti domain-anda.com dan path root sesuai server Anda.
# HTTPS sebaiknya diurus Certbot:
#   sudo certbot --nginx -d domain-anda.com

server {
    listen 80;
    server_name domain-anda.com;

    # Folder hasil `npm run build` di frontend.
    root /var/www/puyuh/dist;
    index index.html;

    # Batasi ukuran request; sesuaikan bila perlu.
    client_max_body_size 10m;

    # Jangan cache index.html agar deploy baru langsung terpakai.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri =404;
    }

    # Aset ber-hash dari Vite aman di-cache lama.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # API backend.
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
    }

    # Health check backend.
    location = /health {
        proxy_pass http://127.0.0.1:8080/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # SPA fallback: semua route frontend diarahkan ke index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
